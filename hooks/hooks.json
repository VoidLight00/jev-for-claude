    "PostToolUse": [{"matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|mcp__.*", "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook-runtime.mjs"], "timeout": 5}]}],
    "PostToolUseFailure": [{"matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|mcp__.*", "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook-runtime.mjs"], "timeout": 5}]}],
    "PreCompact": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook-runtime.mjs"], "timeout": 5}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook-runtime.mjs"], "timeout": 5}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook-runtime.mjs"], "timeout": 5}]}]
  }
}
